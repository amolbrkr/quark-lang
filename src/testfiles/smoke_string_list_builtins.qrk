// smoke_string_list_builtins.qrk
// Covers: string + list builtins (method syntax).

print('== smoke: string/list builtins ==')

// Strings
'hello world'.upper() | print()
'HELLO WORLD'.lower() | print()
'  hello  '.trim() | print()

'hello world'.contains('world') | print()
'hello world'.contains('xyz') | print()
'hello world'.startswith('hello') | print()
'hello world'.endswith('world') | print()

'hello world'.replace('world', 'quark') | print()
'hello ' + 'world' | print()

'  HELLO world  '.trim().lower().replace('world', 'quark') | print()

// Lists
lst = list [10, 20, 30]
len(lst) | print()

// Indexing (includes negative index)
lst.get(0) | print()
lst.get(-1) | print()
lst.get(999) | print()     // null

// push/pop
lst = lst.push(40)
lst.pop() | print()          // 40

// set/insert/remove
lst.set(1, 99) | print()
lst = lst.insert(1, 55)
lst.remove(0) | print()

// slice/reverse/concat
lst.slice(0, 2) | print()
lst.reverse() | print()

lst2 = list [1, 2]
lst.concat(lst2) | print()

// range
range(5) | print()
range(2, 7) | print()
range(10, 0, -3) | print()
