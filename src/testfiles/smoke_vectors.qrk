// smoke_vectors.qrk - Vector comparison operators & boolean mask indexing

print('== smoke: vectors ==')

// --- Vector literal dtype inference ---
vi_lit = vec [1, 2, 3]
vs_lit = vec ['a', 'b', 'c']
print(type(vi_lit))
print(type(vs_lit))

// --- to_vec homogeneous string list ---
vs_from_list = list ['x', 'y', 'z'].to_vec()
print(type(vs_from_list))

// --- Ordering comparisons (vec vs scalar) ---
v = vec [10, 20, 30, 40, 50]

mask = v > 25
print(mask)
print(sum(mask))

mask2 = v < 30
print(sum(mask2))

mask3 = v >= 30
print(sum(mask3))

mask4 = v <= 30
print(sum(mask4))

// --- Equality (vec vs scalar) ---
eq_mask = v == 30
print(sum(eq_mask))

neq_mask = v != 30
print(sum(neq_mask))

// --- Vec vs vec comparison ---
w = vec [10, 25, 30, 35, 50]
cmp = v > w
print(sum(cmp))

// --- Boolean mask indexing ---
big = v[v > 25]
print(big)
print(len(big))

// --- Scalar indexing on vectors ---
print(v[0])
print(v[4])
print(v[-1])

// --- Chained: filter then reduce ---
total = sum(v[v > 25])
print(total)

// --- Empty result ---
none = v[v > 100]
print(len(none))

// --- I64 vectors ---
vi = vec [1, 2, 3, 4, 5]
print(vi[vi > 3])

// --- Scalar comparison with I64 ---
print(sum(vi == 3))
print(sum(vi >= 2))
