// sort.qrk - sort one f64 column ascending (README.md#sort).
incl './lib/harness'

// The checksum: sum(sorted[i] * i) / n.
fn sort_check(xs: list) float ->
    s = 0.0
    for i in range(len(xs)):
        x: float = xs[i]
        s = s + x * i
    s / len(xs)

p = harness::params()
impl: str = p.impl
v = harness::read_f64(p, 'sort.f64', harness::int_param(p, 'n'))
if impl == 'quark_list':
    xs = v.to_list()
    // .sort() sorts in place, so each run sorts a fresh copy.
    out: list = harness::measure(p, 'sort', fn() -> xs.slice(0, len(xs)).sort())
    harness::check(p, 'sort', sort_check(out))
elseif impl == 'quark_vec':
    // Vectors have no sort: go through a list.
    out: vec = harness::measure(p, 'sort', fn() -> v.to_list().sort().to_vec())
    harness::check(p, 'sort', sort_check(out.to_list()))
else:
    harness::unknown_impl(p, 'sort')
