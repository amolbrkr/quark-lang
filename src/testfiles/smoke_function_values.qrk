// smoke_function_values.qrk
// Function values: aliased module members as values, the `fn` annotation,
// and native (fully annotated) functions called from closures.

incl 'std/io' as io

module mathx:
    fn inc(x) -> x + 1
    fn add(x: int, y: int) int -> x + y
    fn twice(f: fn, x) -> f(f(x))
    base = 100


print('== smoke: function values ==')

// Aliased module members used as values
f = mathx::inc
print(f(1))                       // 2
add2 = mathx::add
print(add2(2, 3))                 // 5 (a native function, through its thunk)
print(mathx::twice(mathx::inc, 5))        // 7
print(mathx::base)                    // 100
exists = io::exists
print(exists('no_such_file.txt')) // false
fs = list [mathx::inc, io::exists]       // functions with different signatures
print(fs[0](9))                   // 10
print(type(f))                    // fn

// ...inside lambdas and named functions
plus = fn(v) -> mathx::add(v, 1)
print(plus(1))                    // 2
fn via_module(v) -> mathx::twice(mathx::inc, v)
print(via_module(0))              // 2

// `fn` parameters, return types, variables and struct fields
fn apply(g: fn, x: int) -> g(x)
print(apply(fn(v) -> v * 10, 2))  // 20
print(apply(mathx::inc, 2))           // 3
cb: fn = mathx::inc
print(cb | apply(3))              // 4
fn pick(up: bool) fn -> mathx::inc if up else fn(v) -> v - 1
down = pick(false)
print(down(10))                   // 9

struct Handler:
    name: str
    run: fn
h = Handler { name: 'inc', run: mathx::inc }
run = h.run
print(run(4))                     // 5

// A fully annotated function taking `fn` compiles to native C++
fn apply_native(g: fn, x: int) int -> g(x)
print(apply_native(mathx::inc, 1))    // 2
k = 5
print(apply_native(fn(v) -> v + k, 1)) // 6 (a capturing closure)

// Native functions called from closures and nested functions
fn sum2(x: int, y: int) int -> x + y
w = fn(v) -> sum2(v, 2)
print(w(1))                       // 3
fn outer() ->
    get = fn() -> sum2
    s = get()
    s(3, 4)
print(outer())                    // 7

// A native function's result is checked; an int result widens to float
fn as_float(g: fn) float -> g(1)
print(as_float(fn(v) -> v))       // 1.0

// Calls through function values the compiler can't see through check the
// argument count and fill in defaults (built fresh on every call)
fn id(v) -> v
fn with_default(a, b = 10) -> a + b
dyn = id(with_default)
print(dyn(1))                     // 11
print(dyn(1, 2))                  // 3
fn collect(x, acc = list []) ->
    acc.push(x)
    acc
c = id(collect)
print(c(1))                       // [1]
print(c(2))                       // [2]
