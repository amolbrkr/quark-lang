// Consolidated module smoke: success paths
// Covers local imports, multiple imports, transitive import, duplicate import dedup, and same-file module use.

incl './lib/core'
incl './lib/composed'
incl './lib/core'

module localmod:
    fn inc(n) -> n + 1

incl localmod

print('== smoke: modules success ==')
double(5) | print()
triple(3) | print()
square(4) | print()
double_square(3) | print()
inc(41) | print()
