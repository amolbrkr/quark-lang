use "std/io"

chunk_size = 8 * 1024  // 8 KB

file = io.open("../../testfiles/customers.csv", "r") | unwrap()
raw = to_str(unwrap(io.read(file, chunk_size)))

lines = raw.split('\n')
headers = lines[0].split(',')

rows = list []
i = 1
while i < len(lines):
    line = lines[i].trim()

    if len(line) > 0:
        rows.push(line.split(','))
    i = i + 1


// Create a dict with the header names as keys and the corresponding values from the first row
customer = dict {}
for rowitem in enumerate(rows):
    for header in enumerate(headers):
        customer.set(header.value, rowitem.value[header.index])


for i in customer.keys():
    println(i + ": " + to_str(customer.get(i)))
