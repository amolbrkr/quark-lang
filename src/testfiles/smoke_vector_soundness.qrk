print('== smoke: vec soundness ==')

a = vec [1, 2, 3]
b = vec [1.5, 2.5, 3.5]
print(type(a + b))
print(sum(a + b))
print(type(a + 1.5))
print(sum(a + 1.5))

vi = vec [1, 2, 3]
vf = vi.astype('f64')
print(type(vf))
print(type(vf + vi))
print(sum(vf + vi))

vb = vec [true, false, true]
print(type(vb))
print(sum(vb))

vb2 = list [true, false, null, true].to_vec()
print(type(vb2))
print(sum(vb2))

vn = list [1, null, 3].to_vec()
print(sum(vn))
print(min(vn))
print(max(vn))

acc = 0
for x in vec [1, 2, 3, 4, 5]:
    acc = acc + x
print(acc)
