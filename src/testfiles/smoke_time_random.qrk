print('== smoke: time and random ==')
incl 'std/time' as time
incl 'std/random' as random

start = time.clock()
time.sleep(0.05)
elapsed = time.clock() - start
print(elapsed >= 0.05 and elapsed < 5.0)
print(time.now() > 1700000000.0)

// seed() makes the sequence reproducible.
random.seed(42)
a = random.randint(1, 100)
f = random.uniform()
random.seed(42)
print(a == random.randint(1, 100) and f == random.uniform())
print(f >= 0.0 and f < 1.0)

xs = list [1, 2, 3, 4, 5]
random.shuffle(xs)
print(xs.sort().join(','))
c = random.choice(list ['x', 'y'])
print(c == 'x' or c == 'y')
