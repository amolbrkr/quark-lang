use "std/io" as io

chunk_size = 8 * 1024
chunks_read = 0
rows_read = 0

f = unwrap(io.open("../../testfiles/customers.csv", "r"))

header = list []
columns = dict {}
carry = ""

// Read in chunks and keep trailing partial line in `carry`.
while true:
    res = io.read(f, chunk_size)
    if is_err(res):
        println("read failed")
        break

    chunk = unwrap(res)
    if chunk == "":
        break

    chunks_read = chunks_read + 1

    text = carry + chunk
    lines = ssplit(text, "\n")

    // Keep the last fragment for the next chunk.
    carry = lpop(lines)

    line_index = 0
    while line_index < len(lines):
        line = lget(lines, line_index)

        if line != "":
            fields = ssplit(line, ",")

            if len(header) == 0:
                // First non-empty line becomes header.
                header = fields

                i = 0
                while i < len(header):
                    col_name = lget(header, i)
                    columns = dset(columns, col_name, list [])
                    i = i + 1
            else:
                // Append row fields to per-column list accumulators.
                i = 0
                while i < len(header):
                    col_name = lget(header, i)
                    col_values = dget(columns, col_name)
                    if col_values == null:
                        col_values = list []

                    if i < len(fields):
                        col_values = lpush(col_values, lget(fields, i))
                    else:
                        col_values = lpush(col_values, "")

                    columns = dset(columns, col_name, col_values)
                    i = i + 1

                rows_read = rows_read + 1

        line_index = line_index + 1

// Flush final buffered line if file does not end with '\n'.
if carry != "":
    fields = ssplit(carry, ",")
    if len(header) == 0:
        header = fields
        i = 0
        while i < len(header):
            col_name = lget(header, i)
            columns = dset(columns, col_name, list [])
            i = i + 1
    else:
        i = 0
        while i < len(header):
            col_name = lget(header, i)
            col_values = dget(columns, col_name)
            if col_values == null:
                col_values = list []

            if i < len(fields):
                col_values = lpush(col_values, lget(fields, i))
            else:
                col_values = lpush(col_values, "")

            columns = dset(columns, col_name, col_values)
            i = i + 1

        rows_read = rows_read + 1

io.close(f) | unwrap()

// Convert list columns to vectors once after all chunks are processed.
customer_data = dict {}
i = 0
while i < len(header):
    col_name = lget(header, i)
    col_values = dget(columns, col_name)
    customer_data = dset(customer_data, col_name, vfrom_list(col_values))
    i = i + 1

println("chunks_read=" + to_str(chunks_read))
println("rows_read=" + to_str(rows_read))
println("columns=" + to_str(len(header)))

if len(header) > 0:
    first_col = lget(header, 0)
    first_vec = dget(customer_data, first_col)
    println("first_col=" + first_col)
    println("first_col_type=" + type(first_vec))
    println("first_col_len=" + to_str(len(first_vec)))
