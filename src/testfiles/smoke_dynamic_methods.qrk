print('== smoke: dynamic methods ==')

// Methods on values whose type is unknown at compile time dispatch at runtime.
fn id(x) -> x

text = unwrap(ok('a,b,c'))
parts = text.split(',')
print(len(parts))
print(parts.join('-'))

// Same method name on different receiver types
print(id(list [10, 20]).get(1))
print(id(dict {a: 'x'}).get('a'))
print(id(vec [1.5, 2.5]).get(0))
print(id('hello').slice(1, 3))
print(id(list [1, 2]).concat(list [3]).join(','))

// Chained calls and pipes
print(id(' pad ').trim().upper())
print(id('a;b') | id(';').split() | len())

// Short-circuit: the call is not evaluated
n = id(null)
if n != null and n.upper() == 'A':
    print('unreachable')
print('short-circuit ok')
