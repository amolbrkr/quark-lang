print('== smoke: semantics safety ==')

// --- structural equality for lists, dicts and results ---
a = list [1, 2, list [3, 4]]
b = list [1, 2, list [3, 4]]
print(a == a)
print(a == b)
print(a != b)
print(list [1, 2] == list [1, 3])
print(list [1] == list [1.0])
d = dict { x: 1, y: list ['p'] }
e = dict { y: list ['p'], x: 1 }
print(d == e)
print(d == dict { x: 1 })
r1 = ok 1
r2 = ok 1
r3 = err 1
print(r1 == r2)
print(r1 == r3)
print(list [vec [1, 2]] == list [vec [1, 2]])
print(list [vec [1, 2]] == list [vec [1, 3]])

// --- vec conditions go through all() / any() ---
v = vec [1, 2, 3]
w = vec [1, 0, 3]
print(all(v == w))
print(any(v == w))
print(all(v == v))
print(any(v != v))

// --- results are checked explicitly, not by truthiness ---
print(is_ok(r1) and is_err(r3))

// --- int boundaries that do not overflow ---
big = 9223372036854775806
print(big + 1)
print(2 ** 62)
print(3 ** 39)
print(-7 % 2)

// --- when as an expression ---
x = 3
size = when x:
    1 or 2 -> 'low'
    3 -> 'three'
    _ -> 'other'
print(size)
label: str = when x:
    3 -> 'typed'
    _ -> 'no'
print(label)

fn describe(r) ->
    msg = when r:
        ok val -> 'ok ' + to_str(val)
        err e -> 'err ' + e
    msg

print(describe(ok 5))
print(describe(err 'boom'))
