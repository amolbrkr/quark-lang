// smoke_string_slice_join.qrk
// Covers: str.slice, str +, list.join.

print('== smoke: sslice and sjoin ==')

s = 'hello world'
print(s.slice(0, 5))
print(s.slice(6, 11))
print('abcdef'.slice(2, 4))
print('hello'.slice(2, 5))
print('hello'.slice(0, 3))
print('hello'.slice(2, 4))
print('hi'.slice(0, 99))
print('hi'.slice(5, 8))
print('hi'.slice(1, 1))
print('world'.upper())
print('hello' + ' world')
print(list ['a', 'b', 'c'].join(','))
print('foo' + 'bar')
print(list ['only'].join(','))
print(list [].join(','))
print(list ['1', '2', '3'].join('+'))
print(list ['a', 'b', 'c'].join('-'))
print(list ['one', 'two', 'three'].join('|'))
