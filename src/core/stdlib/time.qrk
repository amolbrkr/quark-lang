extern 'time.hpp'

extern fn time_now() float as 'q_time_now'
extern fn time_clock() float as 'q_time_clock'
extern fn time_sleep(seconds: float) any as 'q_time_sleep'
extern fn time_duration(seconds: float) str as 'q_time_duration'
extern fn time_format(ts: float, pattern: str, local: bool) str as 'q_time_format'
extern fn time_iso(ts: float) str as 'q_time_iso'
extern fn time_parse_time(text: str, pattern: str, local: bool) result as 'q_time_parse'
extern fn time_parse_iso(text: str) result as 'q_time_parse_iso'
// year, month, day, hour, minute, second, weekday, yearday. second is a float.
extern fn time_parts_time(ts: float, local: bool) list as 'q_time_parts'
extern fn time_make(year: int, month: int, day: int, hour: int, minute: int, second: float, local: bool) float as 'q_time_make'

extern fn time_date(year: int, month: int, day: int) date as 'q_time_date'
extern fn time_ymd(text: str) date as 'q_time_ymd'
extern fn time_today(local: bool) date as 'q_time_today'
extern fn time_year(d: date) int as 'q_time_year'
extern fn time_month(d: date) int as 'q_time_month'
extern fn time_day(d: date) int as 'q_time_day'
extern fn time_weekday(d: date) int as 'q_time_weekday'
extern fn time_date_parts(d: date) list as 'q_time_date_parts'
extern fn time_from_days(n: int) date as 'q_time_from_days'
extern fn time_to_days(d: date) int as 'q_time_to_days'
extern fn time_format_date(d: date, pattern: str) str as 'q_time_format_date'
extern fn time_parse_date(text: str, pattern: str) result as 'q_time_parse_date'
extern fn time_period_days(n: int) period as 'q_time_period_days'
extern fn time_period_weeks(n: int) period as 'q_time_period_weeks'
extern fn time_period_months(n: int) period as 'q_time_period_months'
extern fn time_period_quarters(n: int) period as 'q_time_period_quarters'
extern fn time_period_years(n: int) period as 'q_time_period_years'
extern fn time_date_from_ts(ts: float, local: bool) date as 'q_time_date_from_ts'
extern fn time_ts_from_date(d: date, local: bool) float as 'q_time_ts_from_date'

module time:
    // A UTC or local instant. weekday is 0 = Monday. yearday is 1 = 1 January.
    struct Parts:
        year: int
        month: int
        day: int
        hour: int
        minute: int
        second: float
        weekday: int
        yearday: int

    // A calendar day. weekday is 0 = Monday. yearday is 1 = 1 January.
    struct DateParts:
        year: int
        month: int
        day: int
        weekday: int
        yearday: int

    fn now() float -> time_now()
    fn clock() float -> time_clock()
    fn sleep(seconds: float) -> time_sleep(seconds)
    fn since(start: float) float -> clock() - start

    fn seconds(n: float) float -> n
    fn minutes(n: float) float -> n * 60.0
    fn hours(n: float) float -> n * 3600.0
    fn duration(seconds: float) str -> time_duration(seconds)

    // Calendar day.
    fn date(year: int, month: int, day: int) date -> time_date(year, month, day)
    fn ymd(text: str) date -> time_ymd(text)
    fn today(local: bool = false) date -> time_today(local)
    fn year(d: date) int -> time_year(d)
    fn month(d: date) int -> time_month(d)
    fn day(d: date) int -> time_day(d)
    fn weekday(d: date) int -> time_weekday(d)
    fn parts(d: date) DateParts ->
        p = time_date_parts(d)
        DateParts {
            year: p[0]
            month: p[1]
            day: p[2]
            weekday: p[3]
            yearday: p[4]
        }
    fn from_days(n: int) date -> time_from_days(n)
    fn to_days(d: date) int -> time_to_days(d)
    fn format(d: date, pattern: str = '%Y-%m-%d') str -> time_format_date(d, pattern)
    fn parse(text: str, pattern: str = '%Y-%m-%d') result -> time_parse_date(text, pattern)

    // Calendar offsets. Adding one to a date rolls an impossible day back.
    fn days(n: int) period -> time_period_days(n)
    fn weeks(n: int) period -> time_period_weeks(n)
    fn months(n: int) period -> time_period_months(n)
    fn quarters(n: int) period -> time_period_quarters(n)
    fn years(n: int) period -> time_period_years(n)

    // Instants, as float seconds since the Unix epoch.
    // Named timestamp, not time: a member can't share the module's name.
    fn timestamp(year: int, month: int, day: int, hour: int = 0, minute: int = 0, second: float = 0.0, local: bool = false) float -> time_make(year, month, day, hour, minute, second, local)
    fn iso(ts: float) str -> time_iso(ts)
    fn format_time(ts: float, pattern: str = '%Y-%m-%d %H:%M:%S', local: bool = false) str -> time_format(ts, pattern, local)
    fn parse_time(text: str, pattern: str = '%Y-%m-%d %H:%M:%S', local: bool = false) result -> time_parse_time(text, pattern, local)
    fn parse_iso(text: str) result -> time_parse_iso(text)
    fn parts_time(ts: float, local: bool = false) Parts ->
        p = time_parts_time(ts, local)
        Parts {
            year: p[0]
            month: p[1]
            day: p[2]
            hour: p[3]
            minute: p[4]
            second: p[5]
            weekday: p[6]
            yearday: p[7]
        }
    fn date_from_ts(ts: float, local: bool = false) date -> time_date_from_ts(ts, local)
    fn ts_from_date(d: date, local: bool = false) float -> time_ts_from_date(d, local)
