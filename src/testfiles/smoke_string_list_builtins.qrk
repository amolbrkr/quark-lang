// smoke_string_list_builtins.qrk
// Covers: string + list builtins (pipes + direct calls).

println('== smoke: string/list builtins ==')

// Strings
supper('hello world') | println()
slower('HELLO WORLD') | println()
strim('  hello  ') | println()

scontains('hello world', 'world') | println()
scontains('hello world', 'xyz') | println()
sstartswith('hello world', 'hello') | println()
sendswith('hello world', 'world') | println()

sreplace('hello world', 'world', 'quark') | println()
sconcat('hello ', 'world') | println()

'  HELLO world  ' | strim() | slower() | sreplace('world', 'quark') | println()

// Lists
lst = list [10, 20, 30]
len(lst) | println()

// Indexing (includes negative index)
lget(lst, 0) | println()
lget(lst, -1) | println()
lget(lst, 999) | println()     // null

// push/pop
lst = lpush(lst, 40)
lpop(lst) | println()          // 40

// set/insert/remove
lset(lst, 1, 99) | println()
lst = linsert(lst, 1, 55)
lremove(lst, 0) | println()

// slice/reverse/concat
lslice(lst, 0, 2) | println()
lreverse(lst) | println()

lst2 = list [1, 2]
lconcat(lst, lst2) | println()

// range
range(5) | println()
range(2, 7) | println()
range(10, 0, -3) | println()
