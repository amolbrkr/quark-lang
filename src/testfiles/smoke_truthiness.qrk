// smoke_truthiness.qrk
// Covers: truthiness in conditions, short-circuit and/or, ! on non-bool

print('== smoke: truthiness ==')

// Truthiness in if conditions
if 1:
    print('int truthy')
if '':
    print('SHOULD NOT PRINT')
else:
    print('empty str falsy')
if list [1, 2]:
    print('list truthy')
if null:
    print('SHOULD NOT PRINT')
else:
    print('null falsy')
if 0:
    print('SHOULD NOT PRINT')
else:
    print('zero falsy')

// Truthiness in while
x = 3
while x:
    print(x)
    x = x - 1

// Truthiness in ternary
label = 'yes' if 42 else 'no'
print(label)

// Short-circuit and: right side NOT evaluated when left is falsy
// (0 is falsy, so the right side should not be evaluated at all)
res =0 and 999
print(res)

// Short-circuit and: right side IS evaluated when left is truthy
res =1 and 42
print(res)

// Short-circuit or: right side NOT evaluated when left is truthy
res =5 or 999
print(res)

// Short-circuit or: right side IS evaluated when left is falsy
res =0 or 7
print(res)

// ! on non-bool values (truthiness negation)
print(!0)
print(!1)
print(!'hello')
print(!'')
print(!null)

// Short-circuit guard pattern (the critical fix)
lst = list []
if len(lst) > 0 and lst.get(0) == 5:
    print('SHOULD NOT PRINT')
else:
    print('guard ok')

lst = list [5, 10]
if len(lst) > 0 and lst.get(0) == 5:
    print('guard matched')

// Chained and/or
a = 1 and 2 and 3
print(a)

b = 0 or '' or 'fallback'
print(b)

// Mixed bool and non-bool in conditions
if true and 1:
    print('mixed ok')
