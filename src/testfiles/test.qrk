fib = fn(n) -> n if n <= 1 else fib(n - 1) + fib(n - 2)
println(fib(23)) 

s: str = "loool"
println(s[0])
println(len(s))

fn is_palin(s: str) bool -> 
    left = 0
    right = len(s) - 1
    val = true

    while left < right:
        if s[left] != s[right]:
            val = false
            break

        left = left + 1
        right = right - 1
        
    val


println(is_palin(s))
