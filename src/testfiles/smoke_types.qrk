// smoke_types.qrk
// Covers: core value types + typed declarations + dict static/dynamic keys.

print('== smoke: types ==')

// Basic literals
i = 42
f = 3.14
s = 'hello'
b = true
n = null

print(i)
print(f)
print(s)
print(b)
print(n)

// Typed declarations (parser/analyzer coverage)
count: int = 3
name: str = 'quark'
xs: list = list [1, 2, 3]
d: dict = dict { a: 1, b: 2 }

print(count)
print(name)
print(len(xs))
print(d.a)

// Dict static key access
d.c = 99
print(d.c)

// Dict dynamic key access via methods
keys = list ['a', 'b', 'c', 'missing']
for k in keys:
    print(d.get(k))

// Set dynamic key
d = d.set('z', 123)
print(d.z)

// Vector MVP (1D only)
v = vec [1, 2, 3, 4]
print(v)
print(len(v))

w = v + 1
print(w)

u = v * w
print(u)

print(sum(v))
print(min(v))
print(max(v))

// Vector phase-2 helpers
vi = v.astype('i64')
print(vi)
print(sum(vi))
print(min(vi))
print(max(vi))

vplus = vi + 2
print(vplus)

vmul = vi * vplus
print(vmul)

vfilled = vi.fillna(0)
print(vfilled)

print(type(v))
print(type(vi))

v_from_list = list [10, 20, 30].to_vec()
print(v_from_list)
print(sum(v_from_list))

// to_list conversion (vec -> list)
back_to_list = v_from_list.to_list()
print(back_to_list)
print(type(back_to_list))
print(back_to_list.get(0))
