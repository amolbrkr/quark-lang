extern 'io.hpp'

extern fn io_open(path: str, mode: str, binary: bool) result as 'q_file_open'
extern fn io_read(file: resource, n: int) result as 'q_file_read'
extern fn io_write(file: resource, data: str) result as 'q_file_write'
extern fn io_close(file: resource) result as 'q_file_close'
extern fn io_seek(file: resource, offset: int, whence: int) result as 'q_file_seek'
extern fn io_exists(path: str) bool as 'q_file_exists'

module io:
    fn seek_set() int -> 0
    fn seek_cur() int -> 1
    fn seek_end() int -> 2

    // Open `path` with mode 'r' (read), 'w' (truncate and write) or 'a' (append).
    fn open(path: str, mode: str = 'r', binary: bool = false) result -> io_open(path, mode, binary)
    // Read up to `n` bytes; ok('') at end of file.
    fn read(file: resource, n: int) result -> io_read(file, n)
    fn write(file: resource, data: str) result -> io_write(file, data)
    fn close(file: resource) result -> io_close(file)
    fn seek(file: resource, offset: int, whence: int = 0) result -> io_seek(file, offset, whence)
    fn exists(path: str) bool -> io_exists(path)
