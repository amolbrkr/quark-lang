println('== smoke: prefixed builtins ==')

xs = list [10, 20]
xs = xs.push(30)
println(len(xs))
println(xs.get(1))

text = '  hello  '
println(text.trim())
println('abcdef'.contains('cde'))

m = dict { a: 1, b: 2 }
println(len(m.keys()))
println(len(m.values()))

items = m.items()
println(type(items))

pairs = enumerate(list ['x', 'y'])
println(type(pairs))
println(len(pairs))

print('row', '|', 8, 'left', '.')
print('42', '\n', 8, 'right', '0')
