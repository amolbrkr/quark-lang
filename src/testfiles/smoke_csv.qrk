print('== smoke: csv ==')
incl 'std/csv'

struct Note:
    name: str
    note: str

// Quoted fields may hold the separator, doubled quotes and newlines;
// \r\n line endings and blank lines are handled.
text = 'name,note\n"Smith, J","say ""hi"""\r\n\n"multi\nline",x\n'
t: tbl[Note] = unwrap(csv::parse_text(text))
print(len(t.name))
for n in t.name:
    print(n)
print(t.note)
print(csv::format_text(t))

// Without a row type, column types come from the values.
u = unwrap(csv::parse_text('n,x,ok\n1,2.5,true\n2,,false\n'))
print(type(u))

when csv::read_file('definitely_missing_file.csv'):
    ok r -> print('unexpected')
    err e -> print(e.startswith("cannot open 'definitely_missing_file.csv'"))
