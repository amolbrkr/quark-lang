// smoke_native_fns.qrk
// Verifies Phase 2e: fully-annotated functions get native C++ signatures.

print('== smoke: native functions ==')

// Direct call — native signature, no QValue at call boundary
fn add(x: int, y: int) int -> x + y
print(add(3, 4))      // 7

fn scale(v: float, factor: float) float -> v * factor
print(scale(1.5, 4.0))   // 6.0

fn is_pos(x: int) bool -> x > 0
print(is_pos(5))     // true
print(is_pos(-3))    // false

// Scalar-tiered variables passed to native fn — no boxing at call site
a = 10
b = 20
print(add(a, b))    // 30

// Call with result used in further arithmetic
doubled = add(7, 7)
print(doubled)       // 14

// Multi-statement body (last expr is the return value)
fn clamp(v: int, lo: int, hi: int) int ->
    if v < lo:
        lo
    elseif v > hi:
        hi
    else:
        v

print(clamp(5, 0, 10))    // 5
print(clamp(-3, 0, 10))   // 0
print(clamp(99, 0, 10))   // 10

// First-class use — native fn passed through thunk
fn apply(f, x: int) int ->
    f(x)

fn double_it(x: int) int -> x * 2
print(apply(double_it, 6))   // 12
