// == smoke: return type annotations ==
print('== smoke: return type annotations ==')

// Basic return type on named function
fn add(x: int, y: int) int ->
    x + y

print(add(3, 4))

// Return type on single-line function
fn double(n: int) int -> n * 2

print(double(5))

// Float return type
fn pi() float -> 3.14

print(pi())

// String return type
fn greet(name: str) str -> 'Hello, ' + name

print(greet('World'))

// Bool return type
fn is_positive(n: int) bool -> n > 0

print(is_positive(5))
print(is_positive(0 - 1))

// Result return type
fn safe_div(a: int, b: int) result ->
    if b == 0:
        err 'division by zero'
    else:
        ok a / b

when safe_div(10, 2):
    ok v -> print(v)
    err e -> print(e)

when safe_div(10, 0):
    ok v -> print(v)
    err e -> print(e)

// Return type on lambda
square = fn(x: int) int -> x * x

print(square(6))

// Return type with pattern matching
fn describe(n: int) str ->
    when n:
        0 -> 'zero'
        1 -> 'one'
        _ -> 'other'

print(describe(0))
print(describe(1))
print(describe(42))

// Return type with ternary
fn abs_val(n: int) int -> n if n > 0 else 0 - n

print(abs_val(5))
print(abs_val(0 - 3))

// List return type
fn make_list() list -> list [1, 2, 3]

print(len(make_list()))

// Return type used in pipe
5 | double() | print()

// Recursive function with return type
fn fact(n: int) int ->
    when n:
        0 or 1 -> 1
        _ -> n * fact(n - 1)

print(fact(5))
