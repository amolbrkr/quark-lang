{
  "name": "quark-language",
  "displayName": "Quark Language Support",
  "description": "Syntax highlighting, snippets, completion, hover and a run command for the Quark language",
  "version": "0.1.0",
  "publisher": "quark-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amolbrkr/quark-lang"
  },
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "quark",
    "qrk"
  ],
  "activationEvents": [
    "onLanguage:quark"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quark",
        "aliases": [
          "Quark",
          "quark"
        ],
        "extensions": [
          ".qrk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quark",
        "scopeName": "source.quark",
        "path": "./syntaxes/quark.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "quark",
        "path": "./snippets/quark.json"
      }
    ],
    "commands": [
      {
        "command": "quark.runCurrentFile",
        "title": "Quark: Run Current File",
        "category": "Quark",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "quark.runCurrentFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && editorLangId == quark"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "quark.runCurrentFile",
          "when": "resourceLangId == quark",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Quark",
      "properties": {
        "quark.executablePath": {
          "type": "string",
          "default": "quark",
          "description": "Path to the Quark compiler used by 'Quark: Run Current File'. If left as 'quark', the extension uses src/core/quark/quark.exe from an open Quark checkout when one exists, then 'quark' from PATH."
        }
      }
    }
  }
}
