// Consolidated module smoke: success paths (modules v0.2)
// Covers local imports, a transitive import, a file imported along two paths,
// primary modules, file::module::name, same-file modules and `as`.

incl './lib/core'
incl './lib/composed'
incl './lib/core' as core_again

module localmod:
    fn inc(n) -> n + 1

print('== smoke: modules success ==')
core::helpers::double(5) | print()
core::helpers::triple(3) | print()
composed::square(4) | print()
composed::double_square(3) | print()
localmod::inc(41) | print()
// Two modules of one file each define foo.
core::collision_a::foo() | print()
core::collision_b::foo() | print()
core_again::helpers::double(1) | print()
