incl 'std/stats'

print('== smoke: vec soundness ==')

a = vec [1, 2, 3]
b = vec [1.5, 2.5, 3.5]
print(type(a + b))
print(sum(a + b))
print(type(a + 1.5))
print(sum(a + 1.5))

vi = vec [1, 2, 3]
vf = vi.astype('f64')
print(type(vf))
print(type(vf + vi))
print(sum(vf + vi))

vb = vec [true, false, true]
print(type(vb))
print(sum(vb))

vb2 = list [true, false, null, true].to_vec()
print(type(vb2))
print(sum(vb2))

vn = list [1, null, 3].to_vec()
print(sum(vn))
print(min(vn))
print(max(vn))

acc = 0
for x in vec [1, 2, 3, 4, 5]:
    acc = acc + x
print(acc)

// Missing entries stay in the vec; taking one out needs fillna or drop_na (D12).
print(vn.drop_na())
print(len(vn.drop_na()))
print(vn.get(1))
total = 0
for x in vn.drop_na():
    total = total + x
print(total)
for x in vn.fillna(10):
    print(x)
print(vn.fillna(0).to_list())
print(vn[2])

// Reductions follow the table aggregates (D13): int sums stay exact ints.
print(sum(vec [9007199254740993, 1]))
print(max(vec ['pear', 'apple', 'fig']))
print(stats::mean(vn))
print(stats::mean(vec [true, false, false, true]))
