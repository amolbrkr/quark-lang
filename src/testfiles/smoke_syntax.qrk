// smoke_syntax.qrk
// Covers: expressions/precedence, if/elseif/else, when, ternary, lambdas,
// pipes, ok/err results, for/while.

print('== smoke: syntax ==')

// Arithmetic + precedence
x = 1 + 2 * 3
print(x)               // 7

p = 2 ** 3 ** 2
print(p)               // 512 (right associative)

// Unary
neg = -5
print(neg)
print(!false)

// If/elseif/else
if x < 0:
    print('neg')
elseif x == 7:
    print('seven')
else:
    print('other')

// Ternary
label = 'big' if x > 5 else 'small'
print(label)

// When with or + wildcard
when x:
    0 -> print('zero')
    7 or 8 -> print('seven or eight')
    _ -> print('something else')

// Functions + recursion
fn fact(n) ->
    when n:
        0 or 1 -> 1
        _ -> n * fact(n - 1)

fact(6) | print()      // 720

// Lambda + pipe
inc = fn(x) -> x + 1
5 | inc() | print()    // 6

// for loop
total = 0
for i in range(1, 6):
    total = total + i
print(total)             // 15

// while loop
count = 3
while count > 0:
    print(count)
    count = count - 1

// ok/err results + when pattern binding
fn safe_div(a, b) ->
    if b == 0:
        err 'division by zero'
    else:
        ok (a / b)

r1 = safe_div(10, 2)
when r1:
    ok v -> print(v)
    err e -> print(e)

r2 = safe_div(10, 0)
when r2:
    ok v -> print(v)
    err e -> print(e)
