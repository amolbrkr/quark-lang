print('== smoke: printing ==')
incl 'std/fmt' as fmt

// Containers print their contents; strings inside them are quoted.
print(list [1, 'a', null, 2.5, true])
print(list [1.5, null, 2.0].to_vec())
print(vec ['x', 'y'])

// Dict keys are sorted, and quoted unless they read like names.
d = dict {name: 'Ada', age: 36}
d.set('first name', 'A')
print(d)

struct Point:
    x: int
    y: int
print(Point { x: 1, y: 2 })
print(list [ok 5, err 'boom'])

// More than 100 items: first and last 5, plus a count. 100 print in full.
print(range(1000))
print(len(to_str(range(100))))
print(len(fmt.full(range(1000))))

// A list that contains itself.
xs = list [1]
xs.push(xs)
print(xs)

// Floats: shortest form that reads back as the same number.
print(list [4.0, 0.1 + 0.2, 1e16, 1.5e-05])
print('it\'s: ' + to_str(list ['it\'s', 'a\nb']))
