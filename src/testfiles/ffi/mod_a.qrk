// mod_a imports mod_b *before* declaring its own library. The link line
// must still be -lqffi_a -lqffi_b: a module's libraries come before the
// libraries of the modules it imports.
incl './mod_b'

extern link 'qffi_a'
extern 'qffi_a_glue.hpp'

extern fn triple_plus_one(x: int) int as 'qffi_a_triple_plus_one'

module mod_a:
    fn compute(x: int) int -> triple_plus_one(x)
