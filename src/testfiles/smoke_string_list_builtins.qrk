// smoke_string_list_builtins.qrk
// Covers: string + list builtins (method syntax).

println('== smoke: string/list builtins ==')

// Strings
'hello world'.upper() | println()
'HELLO WORLD'.lower() | println()
'  hello  '.trim() | println()

'hello world'.contains('world') | println()
'hello world'.contains('xyz') | println()
'hello world'.startswith('hello') | println()
'hello world'.endswith('world') | println()

'hello world'.replace('world', 'quark') | println()
'hello '.concat('world') | println()

'  HELLO world  '.trim().lower().replace('world', 'quark') | println()

// Lists
lst = list [10, 20, 30]
len(lst) | println()

// Indexing (includes negative index)
lst.get(0) | println()
lst.get(-1) | println()
lst.get(999) | println()     // null

// push/pop
lst = lst.push(40)
lst.pop() | println()          // 40

// set/insert/remove
lst.set(1, 99) | println()
lst = lst.insert(1, 55)
lst.remove(0) | println()

// slice/reverse/concat
lst.slice(0, 2) | println()
lst.reverse() | println()

lst2 = list [1, 2]
lst.concat(lst2) | println()

// range
range(5) | println()
range(2, 7) | println()
range(10, 0, -3) | println()
