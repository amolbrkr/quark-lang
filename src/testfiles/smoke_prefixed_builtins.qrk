print('== smoke: prefixed builtins ==')

xs = list [10, 20]
xs = xs.push(30)
print(len(xs))
print(xs.get(1))

text = '  hello  '
print(text.trim())
print('abcdef'.contains('cde'))

m = dict { a: 1, b: 2 }
print(len(m.keys()))
print(len(m.values()))

items = m.items()
print(type(items))

pairs = list ['x', 'y'].enumerate()
print(type(pairs))
print(len(pairs))

print('row', '|', 8, 'left', '.')
print('42', '\n', 8, 'right', '0')
